# Express Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Replace with your MongoDB Atlas URI or local MongoDB connection
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/upnext?retryWrites=true&w=majority
# Local Example: mongodb://127.0.0.1:27017/upnext
MONGO_URI=mongodb://127.0.0.1:27017/upnext

# JWT Secret Key for Authentication
JWT_SECRET=upnext_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRE=30d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
