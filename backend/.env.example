NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres (pgvector-enabled image)
DATABASE_URL=postgres://nested:nested@postgres:5432/nested

# Redis (queue + cache + rate-limit bucket)
REDIS_URL=redis://redis:6379

# AI provider — OpenRouter. If missing, the MockAIAdapter is used automatically.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# Ingress protection
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Resilience
CIRCUIT_BREAKER_TIMEOUT_MS=15000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_MS=30000
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_MS=250

# Observability
OTEL_SERVICE_NAME=nested-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
